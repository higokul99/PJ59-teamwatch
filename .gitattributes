# Consistent line endings across macOS, Linux, and Windows.
* text=auto
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.mp4 binary
*.m4a binary
